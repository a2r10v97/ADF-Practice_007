										"value": "@activity('Copy data1').output.dataread",
										"type": "Expression"
									},
									"type": "Int32"
								},
								"ErrorId": {
									"value": {
										"value": "@if(\n    greater(length(activity('Copy data1').output.errors), 0),\n    activity('Copy data1').output.errors[0].code,\n    0\n)\n",
										"type": "Expression"
									},
									"type": "Int32"
								},
								"ErrorMessage": {
									"value": {
										"value": "@if(\n    greater(length(activity('Copy data1').output.errors), 0),\n    activity('Copy data1').output.errors[0].message,\n    'No Error'\n)\n",
										"type": "Expression"
									},
									"type": "String"
								},
								"LoadStatus": {
									"value": {
										"value": "@activity('Copy data1').output.executionDetails[0].status",
										"type": "Expression"
									},
									"type": "String"
								},
								"TableName": {
									"value": {
										"value": "table",
										"type": "Expression"
									},
									"type": "String"
								}
							}
						},
